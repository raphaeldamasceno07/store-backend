{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start:dev": "npm run services:up && tsx watch src/server.ts",
    "services:up": "docker compose -f compose.yaml up -d",
    "services:stop": "docker compose -f compose.yaml stop",
    "services:down": "docker compose -f compose.yaml down",
    "start": "node build/server.js",
    "build": "tsup src --out-dir build --format esm",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:watch": "vitest --project e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:create-prisma-environment": "pnpm link --global ./prisma/vitest-environment-prisma",
    "test:install-prisma-environment": "pnpm link --global vitest-environment-prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/static": "9.0.0",
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.4.1",
    "@scalar/fastify-api-reference": "1.44.20",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.2.3",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "6.1.0",
    "open": "11.0.0",
    "pg": "8.16.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@eslint/js": "^9.39.2",
    "@fastify/swagger": "9.6.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^25.0.3",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "prisma": "^7.4.1",
    "supertest": "7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "6.0.4",
    "vitest": "4.0.16"
  }
}
